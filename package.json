{
  "name": "bdo-node-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3910",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "build:data": "node scripts/build-data.mjs",
    "sync:market": "node scripts/sync-market.mjs",
    "deploy": "npm run sync:market && next build && node scripts/nojekyll.mjs && gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
